# ==========================================
# МЭШ Homework Solver Bot Configuration
# ==========================================

# 1. Авторизация МЭШ (Электронный дневник)
# Токен можно скопировать в браузере: F12 -> Network -> запрос к school.mos.ru -> заголовок Authorization (Bearer eyJ...)
MESH_JWT_TOKEN=your_mesh_jwt_token_here
# ID профиля ученика (число в параметрах запросов дневника profile_id=...)
MESH_STUDENT_ID=12345678
# Необязательно (куки сессии МЭШ)
MESH_COOKIES=

# 2. Telegram Bot
# Токен бота, полученный у @BotFather
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrSTUvwxYZ
# ID группы или канала (для групп обычно начинается с -100...)
TELEGRAM_CHANNEL_ID=-1001234567890
# ID администратора в Telegram (числовой, через запятую, если несколько)
TELEGRAM_ADMIN_IDS=123456789

# 3. Solver / LLM Provider Configuration
# Режимы работы SOLVER_MODE:
# - api        : Универсальный HTTP API (OpenRouter, OpenAI, Gemini, Groq, DeepSeek, Ollama)
# - local      : Локальный запуск Antigravity CLI (agy)
# - remote_ssh : Запуск Antigravity CLI через SSH на отдельном сервере
SOLVER_MODE=api
SOLVER_TIMEOUT_SECS=600

# Настройки для SOLVER_MODE=api (OpenAI-совместимый формат):
# Примеры API_BASE_URL:
# - OpenRouter: https://openrouter.ai/api/v1
# - OpenAI:     https://api.openai.com/v1
# - Gemini:     https://generativelanguage.googleapis.com/v1beta/openai/
# - Groq:       https://api.groq.com/openai/v1
# - DeepSeek:   https://api.deepseek.com/v1
# - Ollama:     http://localhost:11434/v1
API_BASE_URL=https://openrouter.ai/api/v1
API_KEY=your_api_key_here
# Примеры моделей:
# - google/gemini-2.5-flash
# - gpt-4o-mini
# - deepseek/deepseek-chat
# - llama-3.3-70b-versatile
API_MODEL=google/gemini-2.5-flash

# Настройки для SOLVER_MODE=local или remote_ssh:
AGY_BIN=agy
AGY_MODEL=gemini-3.8-flash-medium

# 4. SSH параметры (только если SOLVER_MODE=remote_ssh)
SSH_HOST=127.0.0.1
SSH_USER=root
SSH_PORT=22

# 5. Пути к учебникам, правилам и базе данных
TEXTBOOKS_DIR=textbooks_7_grade
RULES_DIR=rules
DB_PATH=data/homeworks.db

# 6. Расписание и проверки
POLL_INTERVAL_SECS=300
DAYS_AHEAD=10
DAYS_BACK=0
AUTO_MARK_DONE=false
