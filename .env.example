# ==========================================
# МЭШ Homework Solver Bot Configuration
# ==========================================

# 1. Авторизация МЭШ (Электронный дневник)
# Токен можно скопировать в браузере: F12 -> Network -> запрос к school.mos.ru -> заголовок Authorization (Bearer eyJ...)
MESH_JWT_TOKEN=your_mesh_jwt_token_here
# ID профиля ученика (число в параметрах запросов дневника profile_id=...)
MESH_STUDENT_ID=12345678
# Необязательно (куки сессии МЭШ)
MESH_COOKIES=

# 2. Telegram Bot
# Токен бота, полученный у @BotFather
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrSTUvwxYZ
# ID группы или канала (для групп обычно начинается с -100...)
TELEGRAM_CHANNEL_ID=-1001234567890
# ID администратора в Telegram (числовой, через запятую, если несколько)
TELEGRAM_ADMIN_IDS=123456789

# 3. Solver (Нейросетевой решатель через Antigravity CLI)
# Режим: local (запуск agy локально на сервере) или remote_ssh (вызов через SSH)
SOLVER_MODE=local
AGY_BIN=agy
# Модель для решения задач (по умолчанию 3.8 flash medium)
AGY_MODEL=gemini-3.8-flash-medium
SOLVER_TIMEOUT_SECS=600

# 4. SSH параметры (только если SOLVER_MODE=remote_ssh)
SSH_HOST=127.0.0.1
SSH_USER=root
SSH_PORT=22

# 5. Пути к учебникам, правилам и базе данных
TEXTBOOKS_DIR=textbooks_7_grade
RULES_DIR=rules
DB_PATH=data/homeworks.db

# 6. Расписание и проверки
POLL_INTERVAL_SECS=300
DAYS_AHEAD=10
DAYS_BACK=0
AUTO_MARK_DONE=false
